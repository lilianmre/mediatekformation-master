<?xml version="1.0" encoding="UTF-8" ?>
<phpdocumentor
    configVersion="3"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns="https://www.phpdoc.org"
    xsi:noNamespaceSchemaLocation="https://docs.phpdoc.org/latest/phpdoc.xsd"
>
    <title>MediaTekFormation - Documentation technique</title>

    <paths>
        <output>docs/</output>
        <cache>.phpdoc/cache</cache>
    </paths>

    <version number="1.0.0">
        <api>
            <source dsn=".">
                <path>src/</path>
                <path>tests/</path>
            </source>
            <output>api</output>
            <ignore hidden="true">
                <path>vendor/</path>
                <path>var/</path>
                <path>public/</path>
            </ignore>
        </api>
    </version>

    <template name="default"/>
</phpdocumentor>
