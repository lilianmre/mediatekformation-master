# Variables d'application à configurer dans Azure App Service > Configuration > Application settings
APP_ENV=prod
APP_DEBUG=0
APP_SECRET=change-this-secret

# Azure Database for MySQL (Flexible Server) - adapter host/user/password/dbname
DATABASE_URL="mysql://<user>:<password>@<server>.mysql.database.azure.com:3306/<database>?serverVersion=8.0&charset=utf8mb4"

# SSL MySQL en production (obligatoire sur Azure)
DATABASE_SSL_CA=/etc/ssl/certs/ca-certificates.crt
DATABASE_SSL_VERIFY_SERVER_CERT=1

# Secret optionnel côté GitHub Actions (étape migrations auto)
# PROD_DATABASE_URL=<même valeur que DATABASE_URL>

# Azure App Service Linux PHP utilise Nginx + PHP-FPM.
# Vérifier que le front controller Symfony public/index.php est servi.
